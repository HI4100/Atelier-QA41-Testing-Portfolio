          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "const data = pm.response.json();",
              "pm.test('Response is an array', function () { pm.expect(data).to.be.an('array'); });",
              "pm.test('Collection is not empty', function () { pm.expect(data.length).to.be.above(0); });",
              "pm.test('First item has a title', function () { pm.expect(data[0]).to.have.property('title'); });"
            ]
          }
        }
      ]
    },
