          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 201', function () { pm.response.to.have.status(201); });",
              "const data = pm.response.json();",
              "pm.test('Response echoes submitted data', function () { pm.expect(data.title).to.eql('Atelier QA41 API test'); pm.expect(data.body).to.eql('Practice POST request from Postman'); pm.expect(data.userId).to.eql(1); });",
              "pm.test('Response includes an ID', function () { pm.expect(data).to.have.property('id'); });"
            ]
          }
        }
      ]
