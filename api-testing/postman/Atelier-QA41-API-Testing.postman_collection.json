{
  "info": {
    "_postman_id": "a41f4d9e-9c11-4f4a-9b71-41a41a000001",
    "name": "Atelier QA41 — API Testing",
    "description": "Beginner REST API test suite for JSONPlaceholder. Prepared for execution; results must be verified in Postman.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "GET — Retrieve one post",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/posts/1",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "posts",
            "1"
          ]
        }
      },
      "event": [
        {
          "listen": "test",
          "script": {
            "type": "text/javascript",
            "exec": [
              "pm.test('Status code is 200', function () { pm.response.to.have.status(200); });",
              "pm.test('Response is JSON', function () { pm.response.to.be.json; });",
              "const data = pm.response.json();",
              "pm.test('Post has required fields', function () { pm.expect(data).to.have.property('id'); pm.expect(data).to.have.property('userId'); pm.expect(data).to.have.property('title'); pm.expect(data).to.have.property('body'); });",
              "pm.test('Post ID is 1', function () { pm.expect(data.id).to.eql(1); });"
            ]
          }
        }
      ]
    },
    {
      "name": "GET — Retrieve posts collection",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
